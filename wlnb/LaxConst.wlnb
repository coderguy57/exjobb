   "value": "ClearAll[\"Global`*\"];\nu[k_] := Apply[Plus, Table[m[j] (x[k] - x[j]) Sign[k - j], {j, 1, n}]]\nux[k_] := Apply[Plus, Table[m[j] Sign[k - j], {j, 1, n}]]\ntime := {x[k_] -> x[k][t], m[k_] -> m[k][t]};\nuntime := {x[k_][t] -> x[k], m[k_][t] -> m[k], x[k_]'[t] -> u[k]^2, \n   m[k_]'[t] -> -m[k] u[k] ux[k]};\ndot[f_] := D[f /. time, t] /. untime",
