  {
   "kind": 2,
   "value": "u[k_] := Apply[Plus, Table[m[j] Exp[-(x[k] - x[j]) Sign[k - j]], {j, 1, n}]]\nux[k_] := Apply[Plus, Table[-m[j] Sign[k - j] Exp[-(x[j] - x[k]) Sign[j - k]], {j, 1, n}]]\ntime := {x[k_] -> x[k][t], m[k_] -> m[k][t]};\nuntime := {x[k_][t] -> x[k], m[k_][t] -> m[k], x[k_]'[t] -> u[k]^2, \n   m[k_]'[t] -> -m[k] u[k] ux[k]};\ndot[f_] := D[f /. time, t] /. untime\nFix[x_] := Simplify[Expand[x]];\n\nn = 2;\nJ = {{1, 0, 0}, {0, -1, 0}, {0, 0, 1}};\nS[k_] := J + {{-l m[k] Exp[-x[k]]},{1},{m[k] Exp[x[k]]}} .  {{m[k] Exp[x[k]], 2, l m[k] Exp[-x[k]]}};\nStot = Fold[Dot, S[#] & /@ Range[n, 1, -1]] /. {l -> -z^2};\nS[1] // MatrixForm\nStot // MatrixForm\n\nK1=Total@Table[2m[i]Exp[x[i]], {i, n}];\nK2=Total@Table[2m[i]Exp[-x[i]], {i, n}];\n(* P = {{0, 0, -1/z^4}, {0, 1/z^2, 0}, {1, 0, 0}}; *)\nP = {{0, -z^4 g h^2/2, 0}, {-g^2 h z^2/4, 0, z^2 h / 2}, {0, -g, 1}} /. {h -> K1, g -> K2};\nP//MatrixForm\nconstS = Fix[Tr[P.Stot]];\nCollect[Fix[constS], z, Simplify]\nFullSimplify[Fix[dot[constS]]]\n\nA=Table[m[i]m[j]Exp[-(x[i] - x[j])Sign[i-j]], {i,n}, {j,n}];\nA//MatrixForm\nkMinors[A_, k_] :=\n Module[{rows, cols},\n  rows = Subsets[Range[Length[A]], {k}];\n  cols = Subsets[Range[Length[A[[1]]]], {k}];\n  Total @ Flatten @ Table[Det[A[[r, c]]], {r, rows}, {c, cols}]\n ]\nFix[kMinors[A,1]]",
