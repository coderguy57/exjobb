{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"];\n(*Define the system of equations*)\nn = 3;\nuF[xx_, t_] := Apply[Plus, Table[m[j][t] Abs[xx - x[j][t]], {j, 1, n}]]\nu[k_, t_] := Apply[Plus, Table[m[j][t] Abs[x[k][t] - x[j][t]], {j, 1, n}]]\nux[k_, t_] := Apply[Plus, Table[m[j][t] Sign[x[k][t] - x[j][t]], {j, 1, n}]]\n\n\n(*Define initial conditions*)\n(* initialConditions = {\n   m[1][0] == 1, x[1][0] == 0,\n   m[2][0] == 1, x[2][0] == 1\n}; *)\ninitialConditions = Flatten[Table[\n   {\n      m[i][0] == RandomReal[{1, 5}],\n      x[i][0] == RandomReal[{1, 5}]\n   },\n   {i, n}\n]]\n\n\n(*Define the system of ODEs*)\neqns = Flatten[Table[\n   {\n     m[i]'[t] == -m[i][t] ux[i, t] u[i, t],\n     x[i]'[t] == u[i, t]^2\n   },\n   {i, n}\n]];\n\n(*Solve the system numerically*)\nTstart = 0;\nTend = 0.5;\nT = {t, Tstart, Tend};\nS = 10^5;\n\nwrapEvents = Flatten[Table[\n   With[\n      {i = i},\n      {\n         (* WhenEvent[x[i][t] > S, {x[i][t] -> -S, m[i][t] -> -m[i][t]}] *)\n         WhenEvent[x[i][t] > S, {x[i][t] -> -S}]\n         (* WhenEvent[x[i][t] < 0 - S, x[i][t] -> 2 L] *)\n      }\n   ],\n   {i, n}\n]];\n\nsol = NDSolve[\n   Join[eqns, initialConditions, wrapEvents], \n   Flatten[Table[{m[i], x[i]}, {i, n}]],\n   T\n];\n\nDraw[x_] := Plot[Evaluate[x], {t, Tstart, Tend}, AspectRatio -> 1]\nToAngle[x_] := ArcTan[x]\n\nDraw[Table[x[i][t] /. sol[[1]], {i, n}]]\nDraw[Table[m[i][t] /. sol[[1]], {i, n}]]\nParametricPlot[\n Evaluate@Table[\n   {\n    m[i][t] Cos[ToAngle[x[i][t]]],\n    m[i][t] Sin[ToAngle[x[i][t]]]\n   } /. sol[[1]],\n   {i, 1, n}\n ],\n {t, 0, Tend},\n PlotRange -> All,\n AspectRatio -> 1\n]",
   "languageId": "wolfram",
   "outputs": [
