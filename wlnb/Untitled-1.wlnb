  {
   "kind": 2,
   "value": "Draw[Table[m[i][t]m[If[i==n,1,i+1]][t] (x[i][t] - x[If[i==n,1,i+1]][t]) /. sol[[1]], {i, n}]]\nDraw[Table[m[i][t]m[If[i==n,2,i+1]][t] /. sol[[1]], {i, n}]]\nDraw[Table[(x[i][t] - x[If[i==n,1,i+1]][t]) /. sol[[1]], {i, n}]]\nToAngle[x_] := ArcTan[x];\nParametricPlot[\n Evaluate@Table[\n   {\n    m[i][t]m[If[i==n,1,i+1]][t] Cos[ToAngle[x[i][t] - x[If[i==n,1,i+1]][t]]],\n    m[i][t]m[If[i==n,1,i+1]][t] Sin[ToAngle[x[i][t] - x[If[i==n,1,i+1]][t]]]\n   } /. sol[[1]],\n   {i, 1, n}\n ],\n {t, 0, Tend},\n PlotRange -> All,\n AspectRatio -> 1\n]",
