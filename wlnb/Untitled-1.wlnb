  {
   "kind": 2,
   "value": "ToAngle[x_] := 2 ArcTan[x];\n\nframe[tmax_?NumericQ] := Module[{τ},\n  ParametricPlot[\n    Evaluate@Table[\n      {\n        m[i][τ] Cos[ToAngle[x[i][τ]]],\n        m[i][τ] Sin[ToAngle[x[i][τ]]]\n      } /. sol[[1]],\n      {i, 1, n}\n    ],\n    {τ, 0, tmax},\n    PlotRange -> All,\n    AspectRatio -> 1,\n    ImageSize -> 600\n  ]\n];\n\nnFrames = 150;\nframes = Table[frame[tmax], {tmax, 0, Tend, Tend/nFrames}];\n\nExport[\"linesAnimation.mp4\", frames, \"FrameRate\" -> 30]",
   "languageId": "wolfram",
