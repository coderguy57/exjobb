   "kind": 2,
   "value": "n=3\nFix[dot[m[1]m[1]g[1,1]+m[2]m[2]g[2,2]+2m[1]m[2]g[1,2]]]\nFix[dot[m[1]m[2]g[1,2]+m[2]m[3]g[2,3]+m[1]m[3]g[1,3]]]\nFix[dot[m[1]m[1]g[1,1]+m[2]m[2]g[2,2]+m[3]m[3]g[3,3]+2m[1]m[2]g[1,2]+2m[2]m[3]g[2,3]+2m[1]m[3]g[1,3]]]\nFix[dot[2m[1]m[2]g[1,2]2m[2]m[3]g[2,3]2m[1]m[3]g[1,3]]]\nFix[dot[m[1]m[1]g[1,1]]]\nFix[dot[m[1]m[2]g[1,2]]]\nFix[dot[m[1]m[2]]]\nH=Table[m[i]m[j]g[i,j], {i,n}, {j,n}];\nH // MatrixForm\nFix[Det[H]]\nFix[dot[Det[H]]]\n(* k[k_] := Sum[m[j] g[k, j], {j, 1, n}, j > k]\nSimplify[m[1]g[1,2]+Sum[m[j] g[1, j], {j, 1, n}, j > 1]] *)",
