{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"];\nu[kk_] := Apply[Plus, Table[m[ll] g[kk,ll], {ll, 1, n}]]\nux[kk_] := Apply[Plus, Table[m[ll] Sign[kk-ll] gp[kk,ll], {ll, 1, n}]]\ntime := {x[k_] -> x[k][t], m[k_] -> m[k][t], g[k_,l_] -> g[k,l][t]};\nuntime := {\n   x[k_][t] -> x[k],\n   m[k_][t] -> m[k],\n   g[i_,j_][t] -> g[i,j],\n   x[k_]'[t] -> u[k]^2, \n   m[k_]'[t] -> -m[k] u[k] ux[k],\n   g[k_,l_]'[t] -> Sign[k-l] gp[k,l] (u[k]^2 - u[l]^2)\n};\ndot[f_] := D[f /. time, t] /. untime\ncollectC[expr_] := Expand[expr] //. {\n  m[i_]^a_. * m[j_]^b_. * g[i_, j_]^r_. :> m[i]^(a - 1) m[j]^(b - 1) c[i, j] g[i,j]^(r - 1) /; a >= 1 && b >= 1 && r >= 1\n  (* m[i_]^a_. g[i_, i_]^r_. :> m[i]^(a - 2) c[i, i] g[i,i]^(r - 1) /; a >= 2 && r >= 1 *)\n}\norder[k_, j_] := {Min[k, j], Max[k, j]}\nfixOrder[expr_] := expr /. {\n   g[i_,j_] -> g @@ order[i,j],\n   gp[i_,j_] -> gp @@ order[i,j]\n};\nsetG[expr_] := expr //. {\n   gp[i_,j_] -> 1,\n   g[i_,i_] -> 0\n   (* gp[i_,j_] -> -1,\n   g[i_,i_] -> 1 *)\n   (* gp[i_,j_] -> -g[i,j],\n   g[i_,i_] -> 1 *)\n   (* g[i_,j_] -> Exp[-(x[i]-x[j])Sign[i-j]] *)\n   (* g[i_,j_] -> (x[i] - x[j])Sign[i - j] *)\n}\n(* Fix[x_] := Simplify[collectC[fixOrder[setG[x]]]]; *)\nFix[x_] := Simplify[fixOrder[setG[x]]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
