       "data": "<div class=\"wexpr\"><wrow><w></w><wb>(</wb><w>⁠</w><wgrid style=\"grid-template-columns:repeat(3,max-content);\"><w><w>0</w></w><w><wrow><w></w><wrow><w></w><w>-</w><wrow><w></w><w>ArcTan</w><wrow><w></w><wb>[</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow></wrow></w><w><wrow><w></w><wrow><w></w><w>-</w><wrow><w></w><w>ArcTan</w><wrow><w></w><wb>[</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow></w><w><wrow><w></w><wrow><w></w><w>-</w><wrow><w></w><w>ArcTan</w><wrow><w></w><wb>[</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow></wrow></w><w><w>0</w></w><w><wrow><w></w><wrow><w></w><w>-</w><wrow><w></w><w>ArcTan</w><wrow><w></w><wb>[</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow></w><w><wrow><w></w><wrow><w></w><w>-</w><wrow><w></w><w>ArcTan</w><wrow><w></w><wb>[</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow></w><w><wrow><w></w><wrow><w></w><w>-</w><wrow><w></w><w>ArcTan</w><wrow><w></w><wb>[</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow></w><w><w>0</w></w></wgrid><w>⁠</w><wb>)</wb></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "MatrixForm[{{0, -(ArcTan[x[1] - x[2]]*m[1]*m[2]), -(ArcTan[x[1] - x[3]]*m[1]*m[3])}, {-(ArcTan[x[1] - x[2]]*m[1]*m[2]), 0, -(ArcTan[x[2] - x[3]]*m[2]*m[3])}, {-(ArcTan[x[1] - x[3]]*m[1]*m[3]), -(ArcTan[x[2] - x[3]]*m[2]*m[3]), 0}}]",
       "mime": "text/plain"
      }
     ],
