wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow><w><w>2</w></w></wsup></wrow><w>+</w><wsup><w></w><wrow><w></w><w>ArcTan</w><wrow><w></w><wb>[</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow><w><w>2</w></w></wsup></wrow><wb>)</wb></wrow><w></w><wsup><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>1</w><wb>]</wb></wrow></wrow><w><w>2</w></w></wsup></wrow><w>+</w><wrow><w></w><wsup><w></w><wrow><w></w><w>ArcTan</w><wrow><w></w><wb>[</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow><wb>]</wb></wrow></wrow><w><w>2</w></w></wsup><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>-</w><wsup><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow><w><w>2</w></w></wsup></wrow><w>+</w><wsup><w></w><wrow><w></w><w>m</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow><w><w>2</w></w></wsup></wrow><wb>)</wb></wrow></wrow></wrow><wb>)</wb></wrow></wrow></w><w><w></w><w><wrow><w></w><w>1</w><w>+</w><wsup><w></w><wrow><w></w><wb>(</wb><wrow><w></w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>2</w><wb>]</wb></wrow></wrow><w>-</w><wrow><w></w><w>x</w><wrow><w></w><wb>[</wb><w>3</w><wb>]</wb></wrow></wrow></wrow><wb>)</wb></wrow><w><w>2</w></w></wsup></wrow></w></w></wfrac></wrow><wb>)</wb></wrow></wrow></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "2*m[1]^2*m[2]^2*m[3]^2*((ArcTan[x[1] - x[3]]*ArcTan[x[2] - x[3]]*(ArcTan[x[1] - x[2]]^2*(-m[1]^2 + m[2]^2) + (-ArcTan[x[1] - x[3]]^2 + ArcTan[x[2] - x[3]]^2)*m[3]^2))/(1 + (x[1] - x[2])^2) + (ArcTan[x[1] - x[2]]*ArcTan[x[2] - x[3]]*((-ArcTan[x[1] - x[2]]^2 + ArcTan[x[2] - x[3]]^2)*m[2]^2 + ArcTan[x[1] - x[3]]^2*(-m[1]^2 + m[3]^2)))/(1 + (x[1] - x[3])^2) + (ArcTan[x[1] - x[2]]*ArcTan[x[1] - x[3]]*((-ArcTan[x[1] - x[2]]^2 + ArcTan[x[1] - x[3]]^2)*m[1]^2 + ArcTan[x[2] - x[3]]^2*(-m[2]^2 + m[3]^2)))/(1 + (x[2] - x[3])^2))",
       "mime": "text/plain"
      }
     ],
