    {
     "items": [
      {
       "data": "<pre>    2                                      2\nm[1]  + 2 Cos[x[1] - x[2]] m[1] m[2] + m[2]  + 2 Cos[x[1] - x[3]] m[1] m[3] + \n \n                                       2\n&gt;   2 Cos[x[2] - x[3]] m[2] m[3] + m[3]  + 2 Cos[x[1] - x[4]] m[1] m[4] + \n \n                                                                      2\n&gt;   2 Cos[x[2] - x[4]] m[2] m[4] + 2 Cos[x[3] - x[4]] m[3] m[4] + m[4]  + \n \n&gt;   2 Cos[x[1] - x[5]] m[1] m[5] + 2 Cos[x[2] - x[5]] m[2] m[5] + \n \n                                                                      2\n&gt;   2 Cos[x[3] - x[5]] m[3] m[5] + 2 Cos[x[4] - x[5]] m[4] m[5] + m[5]\n</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "\"    2                                      2\\nm[1]  + 2 Cos[x[1] - x[2]] m[1] m[2] + m[2]  + 2 Cos[x[1] - x[3]] m[1] m[3] + \\n \\n                                       2\\n>   2 Cos[x[2] - x[3]] m[2] m[3] + m[3]  + 2 Cos[x[1] - x[4]] m[1] m[4] + \\n \\n                                                                      2\\n>   2 Cos[x[2] - x[4]] m[2] m[4] + 2 Cos[x[3] - x[4]] m[3] m[4] + m[4]  + \\n \\n>   2 Cos[x[1] - x[5]] m[1] m[5] + 2 Cos[x[2] - x[5]] m[2] m[5] + \\n \\n                                                                      2\\n>   2 Cos[x[3] - x[5]] m[3] m[5] + 2 Cos[x[4] - x[5]] m[4] m[5] + m[5]\\n\"",
       "mime": "text/plain"
      }
