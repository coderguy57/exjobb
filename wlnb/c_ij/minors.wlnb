{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"];\ntime := {x[k_] -> x[k][t], m[k_] -> m[k][t]};\nuntime := {x[k_][t] -> x[k], m[k_][t] -> m[k], x[k_]'[t] -> u[k]^2, \n   m[k_]'[t] -> -m[k] u[k] ux[k]};\ndot[f_] := D[f /. time, t] /. untime\n\nkMinors[A_, k_] :=\n Module[{rows, cols},\n  rows = Subsets[Range[Length[A]], {k}];\n  cols = Subsets[Range[Length[A[[1]]]], {k}];\n  Total @ Flatten @ Table[Det[A[[r, c]]], {r, rows}, {c, cols}]\n ]\n\nG[f_, i_, j_] = f[(x[i] - x[j]) Sign[i - j]];\nGx[f_, i_, j_] = f'[(x[i] - x[j]) Sign[i - j]] Sign[i-j];\n\ncheck[f_, n_] := Module[{A},\n    u[k_] := Apply[Plus, Table[m[j] G[f, k, j], {j, 1, n}]];\n    ux[k_] := Apply[Plus, Table[m[j] Gx[f, k, j], {j, 1, n}]];\n    A=Table[m[i]m[j]G[f,i,j], {i,n}, {j,n}];\n    Do[\n        const = kMinors[A, i];\n        If[TrueQ[Simplify[Expand[const]] == 0],\n                Print[\"      = 0! i = \", i],\n            If[\n                TrueQ[Simplify[Expand[dot[const]]] == 0],\n                Print[\"    CONST! i = \", i],\n                Print[\"NOT CONST! i = \", i]\n            ]\n        ];\n        (* Print[Simplify[Expand[const]]];\n        Print[Simplify[Expand[dot[const]]]]; *)\n        ,\n        {i, 1, n}\n    ]\n]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1772745595477,
     "endTime": 1772745595956
    },
    "executionOrder": 325,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "n = 8\nu[k_] := Apply[Plus, Table[m[j] (x[k] - x[j]) Sign[k - j], {j, 1, n}]]\nux[k_] := Apply[Plus, Table[m[j] Sign[k - j], {j, 1, n}]]\n\nA=Table[m[i]m[j](x[i] - x[j]), {i,n}, {j,n}];\nA=Table[m[i]m[j](x[i] - x[j])Sign[i-j], {i,n}, {j,n}];\nA//MatrixForm\n\nconst=kMinors[A,7];\nSimplify[Expand[const]]\nSimplify[Expand[dot[const]]]",
   "languageId": "wolfram",
