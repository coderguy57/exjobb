     "items": [
      {
       "data": "<pre>Power[m[1] m[2] Sin[x[1] - x[2]] + m[1] m[3] Sin[x[1] - x[3]] + \n \n&gt;    m[2] m[3] Sin[x[2] - x[3]] + m[1] m[4] Sin[x[1] - x[4]] + \n \n&gt;    m[2] m[4] Sin[x[2] - x[4]] + m[3] m[4] Sin[x[3] - x[4]] + \n \n&gt;    m[1] m[5] Sin[x[1] - x[5]] + m[2] m[5] Sin[x[2] - x[5]] + \n \n&gt;    m[3] m[5] Sin[x[3] - x[5]] + m[4] m[5] Sin[x[4] - x[5]], 2]\n</pre>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "\"Power[m[1] m[2] Sin[x[1] - x[2]] + m[1] m[3] Sin[x[1] - x[3]] + \\n \\n>    m[2] m[3] Sin[x[2] - x[3]] + m[1] m[4] Sin[x[1] - x[4]] + \\n \\n>    m[2] m[4] Sin[x[2] - x[4]] + m[3] m[4] Sin[x[3] - x[4]] + \\n \\n>    m[1] m[5] Sin[x[1] - x[5]] + m[2] m[5] Sin[x[2] - x[5]] + \\n \\n>    m[3] m[5] Sin[x[3] - x[5]] + m[4] m[5] Sin[x[4] - x[5]], 2]\\n\"",
       "mime": "text/plain"
      }
