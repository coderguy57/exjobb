      {
       "data": "m[1]^2 + m[2]^2 + m[3]^2 + 2*E^(x[3] - x[4])*m[3]*m[4] + m[4]^2 + 2*E^x[2]*m[2]*(m[3]/E^x[3] + m[4]/E^x[4]) + 2*E^x[1]*m[1]*(m[2]/E^x[2] + m[3]/E^x[3] + m[4]/E^x[4])",
       "mime": "text/plain"
      }
