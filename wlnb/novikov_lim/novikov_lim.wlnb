{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\nZ1 = a1^2/l1 + a2^2/l2 + 4a1 a2/(l1 + l2)\nZ2 = (l1-l2)^4/((l1+l2)^2l1 l2)a1^2 a2^2 \nW0 = 1\nW1 = l1 a1^2 + l2 a2^2 + a1 a2(4 l1 l2)/(l1 + l2)\nU0 = 1\nU1 = a1 + a2\nU2 = ((l1 - l2)^2 a1 a2)/(l1 + l2)\nx[1] = (1/2)Log[Z2/W1]\nx[2] = (1/2)Log[Z1/W0]\nm[1] = Sqrt[Z2 W1]/(U2 U1)\nm[2] = Sqrt[Z1 W0]/(U1 U0)\n\nax = {a1 -> Exp[t / l1], a2 -> Exp[t / l2]}\n\nFix[expr_] := Simplify[expr /. ax,\n  Assumptions -> {l1 > 0, l2 > 0, l1 != l2, t ∈ Reals}\n];\n\n(* Taylor series around t=0 to order n *)\nn = 1;\nNormal[Series[Fix[m[1]], {t, 0, n}]]\nNormal[Series[Fix[Exp[x - x[1]]], {t, 0, n}]]\nSimplify[Normal[Series[Fix[m[1]Exp[x - x[1]]], {t, 0, n}]]]",
   "languageId": "wolfram",
   "outputs": [
