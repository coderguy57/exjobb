  {
   "kind": 2,
   "value": "xF[i_] := (x[i] /. sol[[1]]);\nuF[i_] := (Apply[Plus, Table[m[j][t] (Abs[x[i][t] - x[j][t]]), {j, 1, n}]] /. sol[[1]]);\n\nimin[t_?NumericQ] := First@Ordering[Table[uF[i], {i, n}], 1];\n\nTsmall = {t, -1, 1};\n\nplotMofMinIndex = Plot[\n  xF[imin[t]][t],\n  Tsmall\n]\n\n\nstep = 0.01;\nwind = 80;\ndata = Table[{t, xF[imin[t]][t]}, {t, Tstart, Tend, step}];\nsmoothed = MovingAverage[data[[All, 2]], wind];\ntimes = data[[Ceiling[wind/2] ;; -Floor[wind/2] - 1, 1]];\ndata = Transpose[{times, smoothed}];\n\nListLinePlot[data]\n\nextra1 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1] - x[i2] + x[i3] - x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\nextra2 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1]x[i3] - x[i2]x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\nextra3 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1]x[i2]x[i3] - x[i1]x[i2]x[i4] + x[i1]x[i3]x[i4] - x[i2]x[i3]x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\n\nallm := Total[\n  Flatten[Table[m[i]  m[j]  Abs[x[j] - x[i]], {i, 1, n}, {j, i, n}]]]\nwith[i_] := Coefficient[allm, m[i]] m[i]\nwithout[i_] := allm - Coefficient[allm, m[i]] m[i]\n\nconst1 = \n  Total[Flatten[Table[x[i]^0 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM41 = const1 - 6 extra1;\nconst2 = \n  Total[Flatten[Table[x[i]^1 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM42 = const2 - 6 extra2;\nconst3 = \n  Total[Flatten[Table[x[i]^2 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM43 = const3 - 6 extra3;\n\ntime := {x[k_] -> x[k][t], m[k_] -> m[k][t]};\n\nPlot[Evaluate[(M42 / M41) /. time /. sol], T]\n\nBarycenter1 = Plot[\n  {\n    xF[imin[t]][t],\n    Evaluate[(M42/M41) /. time /. sol]\n  },\n  Tsmall,\n  AxesLabel -> {\"t\", \"\"},\n  PlotLegends -> {\n    TraditionalForm[Superscript[x, \"*\"]],\n    TraditionalForm[Subscript[M, 42]/Subscript[M, 41]]\n  },\n  PlotRange -> All\n]\n\nBarycenter20 = ListLinePlot[\n  {\n    data,\n    Table[{t, Evaluate[(M42/M41) /. time /. sol][[1]]}, {t, Tstart, Tend, 0.08}]\n  },\n  AxesLabel -> {\"t\", \"\"},\n  PlotLegends -> {\n    TraditionalForm[Superscript[x, \"*\"]],\n    TraditionalForm[Subscript[M, 42]/Subscript[M, 41]]\n  }\n]\n\nExport[\"/home/erik/Documents/exjobb/wlnb/barycenter/BarycenterHS1.pdf\", Barycenter1]\nExport[\"/home/erik/Documents/exjobb/wlnb/barycenter/BarycenterHS20.pdf\", Barycenter20]",
   "languageId": "wolfram",
   "outputs": [
    {
