  {
   "kind": 2,
   "value": "uData[t_?NumericQ] := Module[{xs, ms, ord},\n  xs = Table[x[j][t] /. sol[[1]], {j, 1, n}];\n  ms = Table[m[j][t] /. sol[[1]], {j, 1, n}];\n  ord = Ordering[xs];\n  {xs[[ord]], ms[[ord]]}\n];\n\nimin[t_?NumericQ] := Module[\n  {xs, ms, n0, cand, vals, k, xl, xr, a, b, xcrit},\n  \n  {xs, ms} = uData[t];\n  n0 = Length[xs];\n  \n  (* candidates always include the breakpoints *)\n  cand = xs;\n  \n  (* check one critical point in each open interval *)\n  Do[\n    xl = xs[[k]];\n    xr = xs[[k + 1]];\n    \n    a = Sum[ms[[j]] Exp[xs[[j]]], {j, 1, k}];\n    b = Sum[ms[[j]] Exp[-xs[[j]]], {j, k + 1, n0}];\n    \n    If[a > 0 && b > 0,\n      xcrit = (1/2) Log[b/a];\n      If[xl < xcrit < xr,\n        cand = Append[cand, xcrit]\n      ]\n    ],\n    {k, 1, n0 - 1}\n  ];\n  \n  vals = Total[ms Exp[-Abs[# - xs]]] & /@ cand;\n  cand[[First @ Ordering[vals, 1]]]\n];\n\nTsmall = {t, -0.5, 0.5};\nplotMofMinIndex = Plot[imin[t], Tsmall]\n\nextra1 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (Exp[-Abs[x[i1] - x[i2] + x[i3] - x[i4]]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\nextra2 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (Exp[-Abs[x[i1]x[i3] - x[i2]x[i4]]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\nextra3 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1]x[i2]x[i3] - x[i1]x[i2]x[i4] + x[i1]x[i3]x[i4] - x[i2]x[i3]x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\n\nallm := Total[\n  Flatten[Table[m[i]  m[j]  Exp[-Abs[x[j] - x[i]]], {i, 1, n}, {j, 1, n}]]]\nwith[i_] := Coefficient[allm, m[i]] m[i]\nwithout[i_] := allm - Coefficient[allm, m[i]] m[i]\n\nconst1 = \n  Total[Flatten[Table[x[i]^0 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM41 = const1 - 6 extra1;\nconst2 = \n  Total[Flatten[Table[x[i]^1 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM42 = const2 - 6 extra2;\nconst3 = \n  Total[Flatten[Table[x[i]^2 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM43 = const3 - 6 extra3;\n\ntime := {x[k_] -> x[k][t], m[k_] -> m[k][t]};\n\nBarycenter1 = Plot[\n  {\n    imin[t],\n    Evaluate[(M42/M41) /. time /. sol]\n  },\n  Tsmall,\n  AxesLabel -> {\"t\", \"\"},\n  PlotLegends -> {\n    TraditionalForm[Superscript[x, \"*\"]],\n    TraditionalForm[Subscript[M, 42]/Subscript[M, 41]]\n  },\n  PlotRange -> All\n]\n\nuF[xx_?NumericQ, t_?NumericQ] := Sum[(m[j][t] Exp[-Abs[xx - x[j][t]]]) /. sol[[1]], {j, 1, n}];\n(* Plot[uF[xx, -0.4], {xx, -2, 4}] *)\ntt = 0;\nc = ((M42/M41)/.time/.sol[[1]]) /. {t -> tt};\nPlot[\n  uF[xx, tt],\n  {xx, -2, 4},\n  Epilog -> {Red, Thick, Line[{{c, -10^6}, {c, 10^6}}]}\n]\n(* uF[xx_?NumericQ, t_?NumericQ] := Sum[(m[j][t] Exp[-Abs[xx - x[j][t]]]) /. sol[[1]], {j, 1, n}];\n\nimin[t_?NumericQ] := Module[{xs, xx},\n  xs = Table[x[j][t] /. sol[[1]], {j, 1, n}];\n  NArgMin[{uF[xx, t], Min[xs] <= xx <= Max[xs]}, xx]\n];\n\nTsmall = {t, -0.01, 0.01};\n\nplotMofMinIndex = Plot[\n  imin[t],\n  Tsmall\n] *)\n\n(* \nstep = 0.01;\nwind = 80;\ndata = Table[{t, xF[imin[t]][t]}, {t, Tstart, Tend, step}];\nsmoothed = MovingAverage[data[[All, 2]], wind];\ntimes = data[[Ceiling[wind/2] ;; -Floor[wind/2] - 1, 1]];\ndata = Transpose[{times, smoothed}];\n\nListLinePlot[data]\n\nextra1 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1] - x[i2] + x[i3] - x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\nextra2 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1]x[i3] - x[i2]x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\nextra3 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1]x[i2]x[i3] - x[i1]x[i2]x[i4] + x[i1]x[i3]x[i4] - x[i2]x[i3]x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\n\nallm := Total[\n  Flatten[Table[m[i]  m[j]  Abs[x[j] - x[i]], {i, 1, n}, {j, i, n}]]]\nwith[i_] := Coefficient[allm, m[i]] m[i]\nwithout[i_] := allm - Coefficient[allm, m[i]] m[i]\n\nconst1 = \n  Total[Flatten[Table[x[i]^0 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM41 = const1 - 6 extra1;\nconst2 = \n  Total[Flatten[Table[x[i]^1 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM42 = const2 - 6 extra2;\nconst3 = \n  Total[Flatten[Table[x[i]^2 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM43 = const3 - 6 extra3;\n\ntime := {x[k_] -> x[k][t], m[k_] -> m[k][t]};\n\nPlot[Evaluate[(M42 / M41) /. time /. sol], T]\n\nBarycenter1 = Plot[\n  {\n    xF[imin[t]][t],\n    Evaluate[(M42/M41) /. time /. sol]\n  },\n  Tsmall,\n  AxesLabel -> {\"t\", \"\"},\n  PlotLegends -> {\n    TraditionalForm[Superscript[x, \"*\"]],\n    TraditionalForm[Subscript[M, 42]/Subscript[M, 41]]\n  }\n]\n\nBarycenter20 = ListLinePlot[\n  {\n    data,\n    Table[{t, Evaluate[(M42/M41) /. time /. sol][[1]]}, {t, Tstart, Tend, 0.08}]\n  },\n  AxesLabel -> {\"t\", \"\"},\n  PlotLegends -> {\n    TraditionalForm[Superscript[x, \"*\"]],\n    TraditionalForm[Subscript[M, 42]/Subscript[M, 41]]\n  }\n]\n\nExport[\"BarycenterHS1.pdf\", Barycenter1]\nExport[\"BarycenterHS20.pdf\", Barycenter20] *)",
   "languageId": "wolfram",
