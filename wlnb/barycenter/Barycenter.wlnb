  },
  {
   "kind": 2,
   "value": "(* x[order_] := Ordering[Table[x[i], {i, {i1,i2,i3,i4}}]][[order]]; *)\n(* xi[order_] := Table[x[i], {i, {i1,i2,i3,i4}}][[order]]; *)\n(* xi[order_] := x[order]; *)\nextra1 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1] - x[i2] + x[i3] - x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\nextra2 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1]x[i3] - x[i2]x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\nextra3 = Total[Flatten[Table[m[i1] m[i2] m[i3] m[i4] (-Abs[x[i1]x[i2]x[i3] - x[i1]x[i2]x[i4] + x[i1]x[i3]x[i4] - x[i2]x[i3]x[i4]]), {i1, 1, n}, {i2, i1 + 1, n}, {i3, i2 + 1, n}, {i4, i3 + 1, n}]]];\n\nallm := Total[\n  Flatten[Table[m[i]  m[j]  Abs[x[j] - x[i]], {i, 1, n}, {j, i, n}]]]\nwith[i_] := Coefficient[allm, m[i]] m[i]\nwithout[i_] := allm - Coefficient[allm, m[i]] m[i]\n\nconst1 = \n  Total[Flatten[Table[x[i]^0 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM41 = const1 - 6 extra1;\nconst2 = \n  Total[Flatten[Table[x[i]^1 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM42 = const2 - 6 extra2;\nconst3 = \n  Total[Flatten[Table[x[i]^2 m[i]^2 (allm + 2 without[i]), {i, 1, n}]]];\nM43 = const3 - 6 extra3;\n\ntime := {x[k_] -> x[k][t], m[k_] -> m[k][t]};\n\nPlot[Evaluate[(M42 / M41) /. time /. sol], T]\nPlot[Evaluate[((M43 / M41) - (M42/M41)^2) /. time /. sol], T]\nPlot[Evaluate[((M43 / M42)) /. time /. sol], T]\nxF[i_] := (x[i] /. sol[[1]]);\nmF[i_] := (m[i] /. sol[[1]]);\nuF[i_] := (Apply[Plus, Table[m[j][t] (Abs[x[i][t] - x[j][t]]), {j, 1, n}]] /. sol[[1]]);\n\nimin[t_?NumericQ] := First@Ordering[Table[uF[i], {i, n}], 1];\n\nplotMofMinIndex = Plot[\n  xF[imin[t]][t],\n  T,\n  AxesLabel -> {\"t\", \"m at argmin x\"}\n]\nmeanXValue = Mean[\n  Table[\n    xF[imin[t]][t],\n    {t, Tstart, Tend, 0.001}\n  ]\n]\nmeanXXValue = Mean[\n  Table[\n    xF[imin[t]][t]^2,\n    {t, Tstart, Tend, 0.001}\n  ]\n]\nmeanXXValue - meanXValue^2\nVarainceXValue = Variance[\n  Table[\n    xF[imin[t]][t],\n    {t, Tstart, Tend, 0.001}\n  ]\n]\n(* xMean = Table[Mean[\n    Table[\n      xF[i][t],\n      {t, Tstart, Tend, 0.001}\n    ]\n  ], {i,n}\n]\nMean[xMean] *)",
   "languageId": "wolfram",
   "outputs": [
