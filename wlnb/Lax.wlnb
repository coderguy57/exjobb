   "kind": 2,
   "value": "ClearAll[\"Global`*\"];\nu = U[x, t]; m = M[x, t]; ux = D[U[x, t], x];\nFix[expr_] := (\n  Clear[u, m, ux];\n  temp = expr /. {\n     U[x, t] -> u, M[x, t] -> m,\n     D[U[x, t], {x, 1}] -> ux, D[M[x, t], x] -> mx,\n     D[U[x, t], {x, 2}] -> uxx, D[M[x, t], t] -> mt};\n  temp = temp /. {m -> u - uxx};\n  Simplify[temp])\n\nA = {\n    {-u ux, ux/z - u^2 m z, ux^2},\n    {u/z, -1/z^2, -ux/z - u^2 m z},\n    {-u^2, u/z, u ux}\n};\nL = {{0, z m, 1}, {0, 0, z m}, {1, 0, 0}};\nzcc = L . A - A . L + D[L, t] - D[A, x];\nFix[zcc] // MatrixForm",
