   "kind": 2,
   "value": "ClearAll[\"Global`*\"];\nu = U[x, t]; m = M[x, t]; ux = D[U[x, t], x]; X = (ux x - u);\nFix[expr_] := (\n  Clear[u, m, ux];\n  temp = expr /. {\n     U[x, t] -> u, M[x, t] -> m,\n     D[U[x, t], {x, 1}] -> ux, D[M[x, t], x] -> mx,\n     D[U[x, t], {x, 2}] -> uxx, D[M[x, t], t] -> mt};\n  temp = temp /. {m -> - uxx};\n  Simplify[temp])\n\nA = {\n    {ux X, -ux/l - u^2 m, -ux^2/l},\n    {-X + l u^2 m x, 1/l, ux/l - u^2 m},\n    {l X^2, -X - l u^2 m x, -ux X}\n};\nL = {{0, m, 0}, {-l m x, 0, m}, {0, l m x, 0}};\nzcc = L . A - A . L + D[L, t] - D[A, x];\nFix[zcc] // MatrixForm",
