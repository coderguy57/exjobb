{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"];\n\n(* Parameters *)\nm1 = 1; m2 = -1; m3 = 1;\nK = 2;\n\n(* ---------- Direct ODE system (x1,x2,x3) ---------- *)\n\nc12[x1_, x2_] := m1*m2*(x2 - x1);\nc13[x1_, x3_] := m1*m3*(x3 - x1);\nc23[x2_, x3_] := m2*m3*(x3 - x2);\n\neqns = {\n   x1'[t] == (c12[x1[t], x2[t]] + c13[x1[t], x3[t]])^2,\n   x2'[t] == (c12[x1[t], x2[t]] + c23[x2[t], x3[t]])^2,\n   x3'[t] == (c13[x1[t], x3[t]] + c23[x2[t], x3[t]])^2,\n   x1[0] == -1, x2[0] == 0, x3[0] == 1\n};\n\ntmax = 0.75;\n\nsol = NDSolveValue[\n   eqns, {x1, x2, x3}, {t, 0, tmax},\n   Method -> {\"StiffnessSwitching\"},\n   MaxSteps -> Infinity\n];\n\n(* ---------- Implicit/Beta parametrization ---------- *)\n\ns[v_] := (K/(v (1 - v)))^(1/3);\n\ntOfv[v_] := (1/(3 K^(1/3)))*\n  (Beta[v, 1/3, 1/3] - Beta[1/2, 1/3, 1/3]);\n\nx2Ofv[v_] := (K^(1/3)/3)*\n  (Beta[v, -1/3, -1/3] - Beta[1/2, -1/3, -1/3]);\n\nx1Ofv[v_] := x2Ofv[v] - v s[v];\nx3Ofv[v_] := x2Ofv[v] + (1 - v) s[v];\n\n(* ---------- Compute v(t) (NO ParametricNDSolveValue) ---------- *)\nvfun = NDSolveValue[\n   {\n    v'[t] == 3 K^(1/3) (v[t] (1 - v[t]))^(2/3),\n    v[0] == 1/2\n   },\n   v, {t, 0, tmax},\n   Method -> {\"StiffnessSwitching\"},\n   MaxSteps -> Infinity\n];\n\n(* ---------- Overlay plots ---------- *)\n\nShow[\n {\n  Plot[\n   Evaluate[{sol[[1]][t], sol[[2]][t], sol[[3]][t]}],\n   {t, 0, tmax},\n   PlotStyle -> {Red, Blue, Green},\n   PlotLegends -> Placed[{\"x1 ODE\", \"x2 ODE\", \"x3 ODE\"}, {0.8, 0.2}],\n   PlotRange -> All\n  ],\n\n  Plot[\n   Evaluate@{\n     x1Ofv[vfun[t]],\n     x2Ofv[vfun[t]],\n     x3Ofv[vfun[t]]\n   },\n   {t, 0, tmax},\n   PlotStyle -> {\n     Directive[Red, Dashed],\n     Directive[Blue, Dashed],\n     Directive[Green, Dashed]\n   }\n  ]\n },\n AxesLabel -> {\"t\", \"x\"},\n PlotRange -> All\n]\n\n\nPlot[\n  Evaluate[{Log[sol[[3]][t]]}],\n  {t, 0, tmax},\n  PlotStyle -> {Red, Blue, Green},\n  PlotRange -> All\n]\nPlot[\n  Evaluate[{Log[sol[[3]][t] - sol[[2]][t]]}],\n  {t, 0, tmax},\n  PlotStyle -> {Red, Blue, Green},\n  PlotRange -> All\n]",
   "languageId": "wolfram",
   "outputs": [
