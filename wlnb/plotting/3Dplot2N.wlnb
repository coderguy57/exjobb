{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\n(*Define the system of equations*)\nu[k_, t_] := \n Apply[Plus, Table[m[j][t] (Abs[x[k][t] - x[j][t]]), {j, 1, n}]]\nux[k_, t_] := \n Apply[Plus, \n  Table[m[j][t] ( (x[k][t] - x[j][t])/Abs[x[k][t] - x[j][t]]), {j, \n    DeleteCases[Range[1, n], k]}]]\nuF[xx_, t_] := Apply[Plus, Table[m[j][t] Abs[xx - x[j][t]], {j, 1, n}]]\n\n(*Define the number of equations*)\nn = 2; (*Example for n=5*)\n\n(*Define initial conditions*)\ninitialConditions = {\n   m[1][0] == Sqrt[2]/2, x[1][0] == 0,\n   m[2][0] == Sqrt[2]/2, x[2][0] == 2,\n   m[3][0] == 3, x[3][0] == 2\n   };\n\n(*Define the system of ODEs*)\neqns = Flatten[Table[{\n     m[i]'[t] == -m[i][t] ux[i, t] u[i, t],\n     x[i]'[t] == u[i, t]^2},\n    {i, n}\n    ]];\n\n(*Solve the system numerically*)\nTstart = -Pi/2;\nTend = Pi/2;\nT = {t, Tstart, Tend};\n\n(*Threshold for wrap-around*)\nthreshold = 10^5;\nwrapEvents = Flatten[Table[\n    With[{i = i},\n     {\n      WhenEvent[x[i][t] > threshold, x[i][t] -> -threshold + 1],\n      WhenEvent[x[i][t] < -threshold, x[i][t] -> threshold - 1]\n      }], {i, n}\n    ]];\n\nsol = NDSolve[Join[eqns, initialConditions, wrapEvents], \n   Flatten[Table[{m[i], x[i]}, {i, n}]], T];\nTstart = \n  Apply[Max, Table[sol[[1, i, 2]][\"Domain\"][[1, 1]], {i, 1, 2 n}]];\nTend = Apply[Min, Table[sol[[1, i, 2]][\"Domain\"][[1, 2]], {i, 1, 2 n}]];\nT = {t, Tstart, Tend}\n\nModN[i_] := Mod[i - 1, n] + 1;\ncolor[x_] := ColorData[\"Rainbow\"][x];\ntest = Function[{x, y, z}, color[Rescale[z, {-0.4, 1.05}]]];\nPlot3D[\n uF[x, t] /. sol[[1]],\n {x, -5, 5},\n {t, Tstart, Tend},\n PlotPoints -> 100,\n Boxed -> False,\n ColorFunction -> test,\n AxesLabel -> {\"x\", \"t\", \"u\"},\n Lighting -> {\"Ambient\", White}\n]",
   "languageId": "wolfram",
   "outputs": [
