{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"];\n(*Define the system of equations*)\nL = 10;  (*Threshold for wrap-around*)\n\nDist[a_, b_] := Min[Abs[a - b], L - Abs[a - b]];\nDistX[a_, b_] := Sign[a - b] Sign[L/2 - Abs[a - b]];\nuF[xx_, t_] := Apply[Plus, Table[m[j][t] Dist[xx, x[j][t]], {j, 1, n}]]\nu[k_, t_] := \n Apply[Plus, Table[m[j][t] Dist[x[j][t], x[k][t]], {j, 1, n}]]\nux[k_, t_] := \n Apply[Plus, Table[-m[j][t] DistX[x[j][t], x[k][t]], {j, 1, n}]]\n\nn = 4; \n\ninitialConditions = {\n   m[1][0] == 2, x[1][0] == 1,\n   m[2][0] == 0.5, x[2][0] == 3,\n   m[3][0] == 5, x[3][0] == 4,\n   m[4][0] == 2, x[4][0] == 8.5\n};\n\n(*Define the system of ODEs*)\neqns = Flatten[Table[{\n     m[i]'[t] == -m[i][t] ux[i, t] u[i, t],\n     x[i]'[t] == u[i, t]^2},\n    {i, n}\n    ]];\n(*Solve the system numerically*)\nTstart = -0.0;\nTend = 0.1;\nT = {t, Tstart, Tend};\nS = 10^-4;\nwrapEvents = Flatten[Table[\n    With[{i = i},\n     {\n      WhenEvent[x[i][t] > L + S, x[i][t] -> S],\n      WhenEvent[x[i][t] < 0 - S, x[i][t] -> L - S]\n      }], {i, n}\n    ]];\n\nsol = NDSolve[Join[eqns, initialConditions, wrapEvents], \n   Flatten[Table[{m[i], x[i]}, {i, n}]], T];\nTstart = \n  Apply[Max, Table[sol[[1, i, 2]][\"Domain\"][[1, 1]], {i, 1, 2 n}]];\nTend = Apply[Min, \n   Table[sol[[1, i, 2]][\"Domain\"][[1, 2]], {i, 1, 2 n}]];\nT = {t, Tstart, Tend};\n\nModN[i_] := Mod[i - 1, n] + 1;\ncolor[x_] := ColorData[\"Rainbow\"][x];\ntest = Function[{x, y, z}, color[Rescale[z, {-0.4, 1.05}]]];\nPlot3D[\n   uF[x, t] /. sol[[1]],\n   {x, 0, 10},\n   {t, Tstart, Tend},\n   PlotPoints -> 100,\n   Boxed -> False,\n   ColorFunction -> test,\n   AxesLabel -> {\"x\", \"t\", \"u\"},\n   Lighting -> {\"Ambient\", White}\n]\n\nplotX = Plot[Evaluate[Table[x[i][t] /. sol[[1]], {i, n}]],\n   T,\n   AxesLabel -> {\"t\", \"x\"},\n   AspectRatio -> 1\n]\nExport[\"/home/erik/Documents/exjobb/wlnb/plotting/N4PeriodicPlotX.pdf\", plotX]\n\nplotDistX = Plot[\n   Evaluate[Table[Mod[x[ModN[i]][t] - x[ModN[i + 1]][t], L] /.  sol[[1]], {i, n}]],\n   {t, Tstart, Tend},\n   AxesLabel -> {\"t\", \"x[i+1] - x[i]\"},\n   AspectRatio -> 1\n]\nExport[\"/home/erik/Documents/exjobb/wlnb/plotting/N4PeriodicPlotDistX.pdf\", plotDistX]\n\nplotM = Plot[\n  Evaluate[Table[m[i][t] /. sol[[1]], {i, n}]],\n   {t, Tstart, Tend},\n   AxesLabel -> {\"t\", \"m\"},\n   AspectRatio -> 1\n]\nExport[\"/home/erik/Documents/exjobb/wlnb/plotting/N4PeriodicPlotM.pdf\", plotM]",
   "languageId": "wolfram",
   "outputs": [
    {
