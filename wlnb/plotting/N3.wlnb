{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\n(*Define the system of equations*)\nu[k_, t_] := \n Apply[Plus, Table[m[j][t] (Abs[x[k][t] - x[j][t]]), {j, 1, n}]]\nux[k_, t_] := \n Apply[Plus, \n  Table[m[j][t] ( (x[k][t] - x[j][t])/Abs[x[k][t] - x[j][t]]), {j, \n    DeleteCases[Range[1, n], k]}]]\n\n(*Define the number of equations*)\nn = 3; (*Example for n=5*)\n\n(*Define initial conditions*)\ninitialConditions = {\n   m[1][0] == 1, x[1][0] == 0,\n   m[2][0] == 2, x[2][0] == 1,\n   m[3][0] == 3, x[3][0] == 2\n   };\n\n(*Define the system of ODEs*)\neqns = Flatten[Table[{\n     m[i]'[t] == -m[i][t] ux[i, t] u[i, t],\n     x[i]'[t] == u[i, t]^2},\n    {i, n}\n    ]];\n\n(*Solve the system numerically*)\nTstart = -2;\nTend = 10;\nT = {t, Tstart, Tend};\nsol = NDSolve[Join[eqns, initialConditions], \n   Flatten[Table[{m[i], x[i]}, {i, n}]], T];\nTstart = \n  Apply[Max, Table[sol[[1, i, 2]][\"Domain\"][[1, 1]], {i, 1, 2 n}]];\nTend = Apply[Min, Table[sol[[1, i, 2]][\"Domain\"][[1, 2]], {i, 1, 2 n}]];\nT = {t, Tstart, Tend}\n\nplotM = Plot[Evaluate[Table[m[i][t] /. sol, {i, n}]], T, \n  AxesLabel -> {\"t\", \"m\"},\n  AspectRatio -> 1\n]\nExport[\"/home/erik/Documents/exjobb/wlnb/plotting/N3PlotM.pdf\", plotM]\n\nplotX = Plot[Evaluate[Table[x[i][t] /. sol, {i, n}]], T, \n  AxesLabel -> {\"t\", \"x\"},\n  AspectRatio -> 1\n]\nExport[\"/home/erik/Documents/exjobb/wlnb/plotting/N3PlotX.pdf\", plotX]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
