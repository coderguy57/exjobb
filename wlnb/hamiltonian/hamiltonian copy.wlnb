{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"]\nn = 2;\nFix[expr_] := Simplify[Expand[expr]];\n\nQQ = Table[qq[i, j], {i, n}, {j, n}];\nQP = Table[qp[i, j], {i, n}, {j, n}];\nPP = Table[pp[i, j], {i, n}, {j, n}];\nJ = ArrayFlatten[{{QQ, QP}, {-PQ, PP}}];\nvar = Table[x[i], {i, n}]~Join~Table[m[i], {i, n}];\nPB[F_, G_] := FullSimplify[Sum[\n  J[[i, j]] D[F, var[[i]]] D[G, var[[j]]],\n  {i, 1, 2 n}, {j, 1, 2 n}\n]];\njac[i_, j_, k_] := Sum[\n   J[[l, k]] D[J[[i, j]], var[[l]]] +\n   J[[l, i]] D[J[[j, k]], var[[l]]] +\n   J[[l, j]] D[J[[k, i]], var[[l]]],\n   {l, 1, 2 n}\n];\n\nqq[i_, j_] := -(x[i] - x[j])^2 Sign[i - j] m[j];\nqp[i_, j_] := -(x[i] - x[j]) Sign[i - j] m[i] m[j];\npp[i_, j_] := Sign[i - j] m[i]^2 m[j];\n\nF = m[1]m[2](x[2]-x[1]);\nGI[i_] := m[1]^2x[1]^i + m[2]^2x[2]^i;\nG1 = GI[0];\nG2 = GI[1];\nG3 = GI[2];\n\nPB[F F, G2 G2]\nPB[F, G2]\nPB[F, G3]\nPB[G1, G2]\nPB[G2, G3]\n\nTable[FullSimplify[jac[i, j, k]], {i, 1, 2 n}, {j, 1, 2 n}, {k, 1, 2 n}]",
   "languageId": "wolfram",
   "outputs": [
