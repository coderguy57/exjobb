  {
   "kind": 2,
   "value": "n = 2;\nvar = Table[q[i], {i, n}]~Join~Table[p[i], {i, n}];\n\nH = Sum[p[i] (q[i] - q[j]) Sign[i - j], {i, n}, {j, n}];\nDH = Table[D[H, var[[i]]], {i, 2 n}] /. {Abs' -> Sign};\n\nHT[x_] := If[x > 0, 1, 0];\nG[i_, j_]   := (ap + bp(q[i]-q[j]) + cp(q[i]-q[j])^2) HT[i-j] + (am + bm(q[i]-q[j]) + cm(q[i]-q[j])^2) HT[j-i]\nGp[i_, j_]  := (bp + 2cp(q[i]-q[j])) HT[i-j] + (bm + 2cm(q[i]-q[j])) HT[j-i]\nGpp[i_, j_] := (2cp) HT[i-j] + (2cm) HT[j-i]\nqq[i_, j_] := G[i,j];\nqp[i_, j_] := (d - 1)p[j] Gp[i,j];\npp[i_, j_] := -(d - 1)^2 p[i] p[j] Gpp[i,j];\nqq[i_, j_] := -(q[i] - q[j])^2 Sign[i - j] p[j];\nqp[i_, j_] := -(q[i] - q[j]) Sign[i - j] p[i] p[j];\npp[i_, j_] := Sign[i - j] p[i]^2 p[j];\nQQ = Table[qq[i, j], {i, n}, {j, n}] /. {d -> 0};\nFix[H];\nFix[DH[[1]] qq[1, 1] + DH[[2]] qq[1, 2] + DH[[3]] qp[1, 1] + \n   DH[[4]] qp[1, 2]];\n\nQP = Table[qp[i, j], {i, n}, {j, n}];\nPQ = Table[-qp[j, i], {i, n}, {j, n}];\nPP = Table[pp[i, j], {i, n}, {j, n}];\nP = ArrayFlatten[{{QQ, QP}, {PQ, PP}}];\nP // MatrixForm\nSimplify[DH] // MatrixForm\nrule = {Sign[x_]^2 -> 1};\nFix[expr_] := Simplify[Simplify[expr] /. rule];\nFix[P . DH] // MatrixForm\n\ntest[i_, j_, k_] := Sum[P[[l, k]] D[P[[i, j]], var[[l]]], {l, 2 n}]\nt = Simplify[\n  Fix[Table[\n     test[i, j, k] + test[j, k, i] + test[k, i, j], {i, 2 n}, {j, \n      2 n}, {k, 2 n}] /. {Abs' -> Sign, Sign'[_] -> 0}]]",
   "languageId": "wolfram",
   "outputs": [
