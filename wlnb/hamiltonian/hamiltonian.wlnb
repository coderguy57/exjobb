       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "MatrixForm[{{0, p[2]*(q[1] - q[2])^2, 0, -(p[1]*p[2]*(-q[1] + q[2]))}, {-(p[1]*(-q[1] + q[2])^2), 0, p[1]*p[2]*(q[1] - q[2]), 0}, {0, -(p[1]*p[2]*(q[1] - q[2])), 0, -(p[1]^2*p[2])}, {p[1]*p[2]*(-q[1] + q[2]), 0, p[1]*p[2]^2, 0}}]",
