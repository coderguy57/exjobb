{
 "cells": [
  {
   "kind": 2,
   "value": "ClearAll[\"Global`*\"];\nu = U[x, t]; m = M[x, t]; ux = D[U[x, t], x]; uxx = D[U[x,t], {x, 2}];\nFix[expr_] := (\n  Clear[u, m, ux];\n  temp = expr /. {\n     U[x, t] -> u, M[x, t] -> m,\n     D[U[x, t], {x, 1}] -> ux, D[M[x, t], x] -> mx,\n     D[U[x, t], {x, 2}] -> uxx, D[M[x, t], t] -> mt,\n     D[U[x, t], {x, 3}] -> uxxx, D[U[x, t], t] -> ut};\n  temp = temp /. {m -> u - uxx};\n  Simplify[temp])\n\nB = {{0, 1}, {u - l, 0}};\nV = {{-ux, 2u+4l}, {2u^2 - uxx + 2u l - 4l^2, ux}};\n\nFix[V] // MatrixForm\nFix[B] // MatrixForm\n\nFix[D[V,x]] // MatrixForm\nFix[D[B,t]] // MatrixForm\n\nPrint[\"VU\"]\nFix[V.B] // MatrixForm\nPrint[\"UV\"]\nFix[B.V] // MatrixForm\n\nFix[D[B, t] - D[V, x] + B.V - V.B] // MatrixForm\n",
   "languageId": "wolfram",
   "outputs": [
