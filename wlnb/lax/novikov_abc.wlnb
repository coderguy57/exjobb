{
 "cells": [
  {
   "kind": 2,
   "value": "u = U[x, t]; m = M[x, t]; ux = D[U[x, t], x];\nFix[expr_] := (\n  Clear[u, m, ux];\n  temp = expr /. {\n     U[x, t] -> u, M[x, t] -> m,\n     D[U[x, t], {x, 1}] -> ux, D[M[x, t], x] -> mx,\n     D[U[x, t], {x, 2}] -> uxx, D[M[x, t], t] -> mt};\n  temp = temp /. {m -> u - uxx};\n  Simplify[temp])\n\nA = {\n    {-u ux, ux/z - u^2 m z, ux^2},\n    {u/z, -1/z^2, -ux/z - u^2 m z},\n    {-u^2, u/z, u ux}\n};\nL = {{0, z m, 1}, {0, 0, z m}, {1, 0, 0}};\n\nFix[A].{a Exp[x] + z^2 c Exp[-x], 2 b z, a Exp[x] - z^2 c Exp[-x]} // MatrixForm\n\nF = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};\nF = {{Exp[x], 0, z^2 Exp[-x]}, {0, 2 z, 0}, {Exp[x], 0, -z^2 Exp[-x]}};\nF = Inverse[F];\nF // MatrixForm\nA = Simplify[(D[F, t] + F . A) . Inverse[F]];\nFix[A] // MatrixForm\nL = Simplify[(D[F, x] + F . L) . Inverse[F]];\nFix[L] // MatrixForm\n\nzcc = L . A - A . L + D[L, t] - D[A, x];\nFix[zcc] // MatrixForm",
   "languageId": "wolfram",
